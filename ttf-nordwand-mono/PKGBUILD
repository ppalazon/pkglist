# Maintainer: Pablo Palazon <ppalazon@phyxor.com>

_fontname="nordwand-mono"
_pkgname="ttf-$_fontname"
pkgbase="$_pkgname"
pkgname="${_pkgname}"
pkgver=1.3.2
pkgrel=1
pkgdesc="A compact monospace neo-grotesque font designed for developers (and adventurers)"
arch=('any')
license=('OFL-1.1-no-RFN')
url="https://github.com/tywr/Nordwand-Mono"
source=(
  "$pkgname-$pkgver.zip::$url/releases/download/$pkgver/NordwandMono-TTF.zip"
  "$_fontname-$pkgver-LICENSE.txt::https://raw.githubusercontent.com/tywr/Nordwand-Mono/refs/tags/$pkgver/LICENSE-FONT.txt"
)
sha256sums=(
  '2359518a2e6c74f50a89125730772e68de6c887951ff414e11b47ea528ce6a8a'
  'e0e493edae714ad5bb243a346f3fd45ecdd94a00584118297f2d05e0f6187d38'
)

package() {
  pkgdesc+=' (14 static cuts)'
  install -Dm644 -t "$pkgdir/usr/share/fonts/$_fontname" ./*.ttf
  install -Dm644 "$_fontname-$pkgver-LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
